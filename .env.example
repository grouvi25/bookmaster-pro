# ============================================================
# ПЛАТФОРМЫ
# ============================================================
TG_BOT_TOKEN=                    # Получить у @BotFather
TG_WEBHOOK_URL=                  # https://yourdomain.com/webhook/tg
TG_WEBHOOK_SECRET=               # Любая случайная строка 32+ символа

MAX_BOT_TOKEN=                   # Получить в VK Dev Console
MAX_WEBHOOK_URL=                 # https://yourdomain.com/webhook/max

# ============================================================
# СУПЕРАДМИН (Telegram/MAX user_id владельца, через запятую)
# ============================================================
SUPERADMIN_IDS=123456789

# ============================================================
# БАЗА ДАННЫХ
# ============================================================
DATABASE_URL=postgresql+asyncpg://bookmaster:devpassword@localhost:5432/bookmaster
DATABASE_URL_SYNC=postgresql://bookmaster:devpassword@localhost:5432/bookmaster
DB_PASSWORD=devpassword

REDIS_URL=redis://localhost:6379/0

# ============================================================
# AI ПРОВАЙДЕРЫ
# ============================================================
AI_DEFAULT_PROVIDER=openai

OPENAI_API_KEY=sk-...
OPENAI_MODEL_FAST=gpt-4o-mini
OPENAI_MODEL_SMART=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-ada-002

YANDEX_GPT_API_KEY=
YANDEX_GPT_FOLDER_ID=
YANDEX_GPT_MODEL=yandexgpt-pro

CLAUDE_API_KEY=

# Speech
YANDEX_STT_API_KEY=
YANDEX_TTS_API_KEY=
OPENAI_WHISPER_MODEL=whisper-1

# ============================================================
# ПЛАТЕЖИ (ЮKassa)
# ============================================================
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_WEBHOOK_URL=https://yourdomain.com/webhook/yookassa
YOOKASSA_AGENT_ID=

# ============================================================
# ХРАНИЛИЩЕ (S3-совместимый)
# ============================================================
S3_ENDPOINT_URL=https://storage.yandexcloud.net
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=bookmaster-files
S3_PUBLIC_URL=https://storage.yandexcloud.net/bookmaster-files

# ============================================================
# ПРИЛОЖЕНИЕ
# ============================================================
APP_URL=https://app.bookmaster.pro
MARKETPLACE_URL=https://bookmaster.pro
API_URL=https://api.bookmaster.pro
SECRET_KEY=change-me-to-64-random-characters
ALGORITHM=HS256

# Настройки бронирования
TIMEZONE=Europe/Moscow
MAX_ADVANCE_BOOKING_DAYS=30
SLOT_RESERVE_MINUTES=5
WAITLIST_CONFIRM_MINUTES=30
REMINDER_HOURS_BEFORE=2

# ============================================================
# МОНИТОРИНГ
# ============================================================
SENTRY_DSN=
ENVIRONMENT=development
DEBUG=true
